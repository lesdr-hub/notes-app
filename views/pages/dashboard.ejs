<!DOCTYPE html>
<html lang="en" data-theme="<%= user.preferences.theme || 'dark'%>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>[ noted ] - Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <!-- OVERLAY (shared by settings and note editor) -->
  <div class="overlay" id="overlay"></div>

  <!-- USER PANEL -->
  <%- include("../partials/account") %>

  <!-- SETTINGS PANEL -->
  <%- include("../partials/settings") %>

  <!-- ACTIVE NOTE PANEL -->
  <%- include("../partials/active-note") %>

  <!-- TOP BAR -->
  <header class="topbar">
    <div class="topbar-left">
      <div class="logo">[ noted ]</div>
    </div>
    <div class="topbar-right">
      <button class="icon-btn" id="refresh-btn" title="Refresh">
        <span class="material-icons">refresh</span>
      </button>
      <button class="icon-btn" id="settings-btn" title="Settings">
        <span class="material-icons">settings</span>
      </button>
      <div class="avatar" id="account-btn" title="Account">
        <%= user && user.username ? user.username[0].toUpperCase() : "?" %>
      </div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <a class="nav-item active" href="/dashboard">
      <span>Notes</span>
    </a>
    <div class="nav-divider"></div>
    <form action="/auth/logout" method="POST" class="logout-form">
      <button id="logout" class="nav-item nav-item--btn">
        <span class="material-icons">logout</span>
        <span>Log out</span>
      </button>
    </form>
    
    <!-- TO BE ADDED -->
    <!-- <a class="nav-item" href="#">
      <span class="material-icons">archive</span>
      <span>Archive</span>
    </a>
    <a class="nav-item" href="#">
      <span class="material-icons">delete</span>
      <span>Trash</span>
    </a>  -->
  </nav>

  <!-- MAIN CONTENT -->
  <main class="main">

    <!-- NEW NOTE BAR -->
    <div class="new-note-bar">
      <div class="new-note-input" id="new-note-trigger">
        <span class="new-note-placeholder">Take a note…</span>
        <div class="new-note-actions">
      </div>
    </div>

    <!-- NOTE GRID -->
    <div id="note-container">
      <%- include("../partials/note-list", { unpinnedNotes, pinnedNotes }) %>
    </div>
    
  </main>

  <script src="/js/script.js"></script>
</body>
</html>
