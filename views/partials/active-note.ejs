

<div class="note-editor">

    <!-- Header -->
    <div class="note-header">
        <input type="text" name="title" class="note-title" placeholder="Title">
        <button type="button" class="pin-btn" title="Pin note">
            Pin <!-- replace with image later -->
        </button>
    </div>

    <!-- Content -->
    <textarea
        name="content"
        class="note-content"
        placeholder="Take a note..."
        rows="10"
    ></textarea>

    <!-- Bottom buttons -->
    <div class="Note options">
        <select name="color" class="color-picker" title="Note color">
            <option value="default">Default</option>
            <option value="yellow">Yellow</option>
            <option value="blue">Blue</option>
            <option value="green">Green</option>
            <option value="red">Red</option>
        </select>

        <button class="options">Options</button>

        <button>Close</button>
    </div>
</div>