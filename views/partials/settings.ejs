<div class="settings-panel" id="settings-panel">

  <header class="settings-header">
    <span class="settings-title">Settings</span>
    <button class="icon-btn close-settings" id="close-settings-btn" title="Close">
      <span class="material-icons">close</span>
    </button>
  </header>

  <hr class="settings-divider">

  <div class="settings-section">
    <span class="settings-section-label">Theme</span>
    <div class="theme-toggle">
      <button class="theme-btn" data-theme-btn="dark">Dark</button>
      <button class="theme-btn" data-theme-btn="light">Light</button>
    </div>
  </div>

  <hr class="settings-divider">

  <div class="settings-footer">
    <button class="text-btn" id="settings-ok-btn">OK</button>
  </div>

</div>

<div id="settings-error">
  
</div>
