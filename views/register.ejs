<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>[ noted ] - Register</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  <link rel="stylesheet" href="../../public/css/styles.css">
</head>
<body>

<main>
  <div class="header">
    <div class="Logo"><!-- replace with logo --></div>
    <div class="title">Create Account</div>
  </div>

  <form class="login-form">
    <input class="email-input" placeholder="Email">
    <input class="password-input" placeholder="Password">
    <input class="confirm-password" placeholder="Confirm Password">
    <button class="submit">Sign up with Email</button>
  </div>

  <div class="footer">
    <div>Already have an account?</div>
    <a href="/auth/login">Log In</a>
  </div>
</main>

</body>
</html>